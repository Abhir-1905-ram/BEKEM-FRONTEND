# Vite loads automatically:
#   .env.development  → npm run dev  (local backend)
#   .env.production   → npm run build (Railway on Vercel)

# Local:
# VITE_API_URL=/api
# VITE_SOCKET_URL=http://localhost:4000

# Production:
# VITE_API_URL=https://bekem-backend-production.up.railway.app/api
# VITE_SOCKET_URL=https://bekem-backend-production.up.railway.app
